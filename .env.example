# Copie para `.env` e preencha. O `.env` nunca vai para o git.

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=troque-esta-senha

# ── API ──────────────────────────────────────────────────────────────────────
# Dentro do compose o host é `postgres`; rodando a API fora do container, `localhost`.
DATABASE_URL=postgresql://kingdc:troque-esta-senha@localhost:5432/kingdc
# 32+ bytes aleatórios: openssl rand -base64 32
SESSION_SECRET=gere-com-openssl-rand-base64-32
AVATAR_DIR=./data/avatars

# ── LiveKit ──────────────────────────────────────────────────────────────────
# Dev: projeto do LiveKit Cloud. Prod (VPS): o livekit-server do compose, com chaves
# NOVAS geradas por você (não as do Cloud). Exemplo de par: openssl rand -hex 8 (key)
# e openssl rand -base64 32 (secret).
LIVEKIT_URL=wss://seu-projeto.livekit.cloud
# Prod: http://host.docker.internal:7880 (o livekit roda em network_mode: host e a API
# só o alcança pelo gateway do Docker; `localhost` dentro do container é a própria API).
LIVEKIT_HOST_HTTP=https://seu-projeto.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Seed do primeiro admin ───────────────────────────────────────────────────
# O código é o login do admin e precisa usar só o alfabeto de convite
# ABCDEFGHJKLMNPQRSTUVWXYZ23456789 (sem 0, O, 1, I), 6 caracteres.
SEED_ADMIN_CODE=ADMKNG
SEED_ADMIN_PASSWORD=troque-esta-senha

# ── Web ──────────────────────────────────────────────────────────────────────
# Alvo dos rewrites do Next. No compose: http://api:3000.
API_INTERNAL_URL=http://localhost:3000

# ── Caddy (só em produção) ───────────────────────────────────────────────────
# Os dois domínios precisam apontar (registro A) para o IP da VPS antes do primeiro `up`.
PUBLIC_DOMAIN=kingdc.seudominio.com
LIVEKIT_DOMAIN=lk.seudominio.com

# ── Portas locais (opcional) ─────────────────────────────────────────────────
# Só têm efeito no docker-compose.override.yml (dev). Mude se a porta já estiver em uso.
# POSTGRES_HOST_PORT=5432
# API_HOST_PORT=3000
# WEB_HOST_PORT=3001

# ── Só para desenvolvimento do front ─────────────────────────────────────────
# Libera a rota /dev-call no build de produção (e2e). Nunca defina em produção.
# NEXT_PUBLIC_DEV_CALL=1
