{
  "name": "king-dc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm -r test:e2e",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "prepare": "pnpm --filter @kingdc/contracts build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  }
}
