// Schema documentado em docs/ARQUITETURA.md. Mudança aqui pede migração e doc atualizada.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(cuid())
  code            String    @unique
  nickname        String?
  avatarUpdatedAt DateTime?
  passwordHash    String
  isAdmin         Boolean   @default(false)
  createdAt       DateTime  @default(now())
  sessions        Session[]
  invitesMade     Invite[]  @relation("InviteCreatedBy")
}

model Invite {
  code        String    @id
  createdById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  createdBy   User      @relation("InviteCreatedBy", fields: [createdById], references: [id])

  @@index([createdById])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Channel {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
}
